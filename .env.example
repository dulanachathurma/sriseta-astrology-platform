# ============================================================
# Sri Seta Astrology Platform — Local Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# --- Frontend API Base URL ---
# Leave EMPTY in production (Vercel handles /api routing automatically).
# For local `vite dev` only: leave empty — Vite will proxy to localhost.
VITE_API_BASE_URL=

# --- MongoDB Atlas ---
# Get this from: https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# --- JWT Secret ---
# Use a long random string. Never share this.
JWT_SECRET=sriseta_super_secret_jwt_key_2026

# --- Google Gemini API Key ---
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Weekly Horoscope (Existing) ---
HOROSCOPE_SOURCE_URL=https://www.divaina.lk/nakatha/84589
HOROSCOPE_CACHE_SECONDS=3600
